{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "firefox-devtools": {
        "type": "local",
        "command": ["npx", "-y", "@mozilla/firefox-devtools-mcp@latest"]
      },
      "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp", "--api-key", "YOUR_API_KEY"],
      "enabled": false
    }
    }
  }
}

